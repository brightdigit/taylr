# App Store Connect API Credentials
# Generate these at: https://appstoreconnect.apple.com/access/api
# Required permissions: App Manager or Admin role

# API Key Issuer ID (UUID format like 12345678-1234-1234-1234-123456789012)
APP_STORE_CONNECT_API_KEY_ISSUER_ID=

# API Key ID (10-character string like ABC1234DEF)
APP_STORE_CONNECT_API_KEY_KEY_ID=

# API Key Content (base64-encoded .p8 file)
# To generate: cat /path/to/AuthKey_*.p8 | base64
# On macOS, use: cat /path/to/AuthKey_*.p8 | base64
APP_STORE_CONNECT_API_KEY_KEY=

# Match Configuration (password for certificate repository)
MATCH_PASSWORD=

# App Configuration (optional - defaults are set in fastlane/Appfile)
# Uncomment to override:
# APP_IDENTIFIER={{TEMPLATE_BUNDLE_ID}}
# APPLE_ID={{TEMPLATE_APPLE_ID}}

# App Store Connect App ID (numeric) — assigned after `fastlane setup_app`
# Required for TestFlight upload
# APP_STORE_APP_ID=

# TestFlight Beta Metadata (optional — defaults set in fastlane/.env.default)
# BETA_CHANGELOG=New features and bug fixes.
# BETA_APP_DESCRIPTION=
# BETA_FEEDBACK_EMAIL=
