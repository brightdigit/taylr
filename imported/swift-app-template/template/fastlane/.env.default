# fastlane/.env.default
#
# Auto-loaded by fastlane on every invocation. Values here become available
# as ENV[...] in Appfile and Fastfile.
#
# This file holds NON-SECRET defaults that are safe to commit. For secrets
# and local overrides, create a sibling `fastlane/.env` (gitignored).
# For lane-specific overrides, create `fastlane/.env.<lane>` (also auto-loaded
# when that lane runs).
#
# The Fastfile reads these via `ENV.fetch("KEY")`, which raises a clear
# KeyError if a required value is missing — so don't comment them out.
# Override in `fastlane/.env` (gitignored) instead.
#
# Identity (app_identifier, apple_id, team_id, itc_team_id) lives in Appfile.

# --- Required: app name (used as scheme name + ASC display name) ---

APP_NAME={{TEMPLATE_APP_NAME}}

# --- Required: platform configuration ---
# Change all four together when targeting a different platform.
#   PLATFORM            fastlane platform identifier ("mac", "ios", "tvos", "watchos")
#   PRODUCE_PLATFORM    produce action's platform string ("osx", "ios", "tvos", "watchos")
#   TEST_DESTINATION    xcodebuild destination string
#   BUILD_ARTIFACT_EXT  release artifact extension ("pkg" for macOS, "ipa" otherwise)

PLATFORM={{TEMPLATE_FASTLANE_PLATFORM}}
PRODUCE_PLATFORM={{TEMPLATE_PRODUCE_PLATFORM}}
TEST_DESTINATION={{TEMPLATE_TEST_DESTINATION}}
BUILD_ARTIFACT_EXT={{TEMPLATE_BUILD_ARTIFACT_EXT}}

# --- Required: App Group (created and associated by `setup_groups`) ---

APP_GROUP_ID={{TEMPLATE_APP_GROUP_ID}}

# TestFlight "What to Test" notes come from fastlane/changelog.txt (versioned
# with the code), not from an env var.

# --- Optional overrides (Fastfile has sensible fallbacks) ---

# Numeric App Store Connect app ID — populate after `setup_app` registers
# the app. Found in App Store Connect → App → App Information → "Apple ID".
# APP_STORE_APP_ID=

# BETA_APP_DESCRIPTION defaults to APP_NAME if unset.
# BETA_APP_DESCRIPTION=

# BETA_FEEDBACK_EMAIL defaults to apple_id from Appfile if unset.
# BETA_FEEDBACK_EMAIL=

# Background colour for framed screenshots (capture_frame). Defaults to #1A1A1A.
# FRAME_BACKGROUND_COLOR=#1A1A1A

# --- Secrets (set in `.env` locally, repo secrets in CI — never commit) ---
#
# MATCH_PASSWORD=                       # match's encryption passphrase
# MATCH_GIT_BASIC_AUTHORIZATION=        # if certs repo uses HTTPS + PAT
# APP_STORE_CONNECT_API_KEY_KEY_ID=
# APP_STORE_CONNECT_API_KEY_ISSUER_ID=
# APP_STORE_CONNECT_API_KEY_KEY=        # base64-encoded .p8 contents
# FASTLANE_SESSION=                     # Apple ID session for upload_privacy_details
#                                       # (generate with `fastlane spaceauth -u <apple_id>`)
